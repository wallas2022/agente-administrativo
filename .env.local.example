# Agente Administrativo — variables de entorno para el AMBIENTE LOCAL (desarrollo)
# Copiar a .env.local y completar. No versionar .env.local con valores reales.
# Uso: docker compose --env-file .env.local -f infra/compose.yml -f infra/compose.local.yml up -d
# Relacionado con: docs/03-diseno/despliegue/estrategia-ambientes.md, infra/compose.local.yml
#
# Sin secretos reales: los valores de contraseña aquí son fijos y de solo desarrollo,
# NO deben reutilizarse en stage/producción.

# --- General ---
APP_ENV=local
APP_NAME=agente-administrativo
APP_TIMEZONE=America/Guatemala
APP_LOCALE=es-GT
LOG_LEVEL=debug

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=dev-local-solo-desarrollo

# --- Orquestador (LangGraph) ---
ORQUESTADOR_MAX_CONCURRENCIA=2

# --- Redis (colas / caché de sesión) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev-local-solo-desarrollo

# --- Motor LLM (Ollama / llama.cpp) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL_PRINCIPAL=gpt-oss:20b   # aprox. — PC local confirmada 128 GB RAM sin GPU; alternativa Qwen3-30B-A3B (ver estrategia-ambientes.md §2)
LLM_MODEL_EMBEDDINGS=bge-m3
LLM_CONTEXT_WINDOW=[POR CONFIRMAR]

# --- Base vectorial (Qdrant) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLECCION=agente_admin_kb_local

# --- Base de datos relacional (PostgreSQL 16) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agente_administrativo
POSTGRES_USER=agente_dev
POSTGRES_PASSWORD=dev-local-solo-desarrollo

# --- Almacenamiento de objetos (MinIO) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=dev-local-solo-desarrollo
MINIO_SECRET_KEY=dev-local-solo-desarrollo
MINIO_BUCKET_DOCUMENTOS=documentos
MINIO_USE_SSL=false

# --- OCR ---
TESSERACT_LANG=spa
OCR_DPI_MINIMO=[POR CONFIRMAR]

# --- Ortografía (LanguageTool) ---
LANGUAGETOOL_HOST=languagetool
LANGUAGETOOL_PORT=8010
LANGUAGETOOL_LOCALE=es-GT

# --- Autenticación (usuarios locales de prueba, sin AD/LDAP real) ---
LDAP_SERVER_URL=[POR CONFIRMAR: en local se recomiendan usuarios de prueba, no AD real]
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# --- Observabilidad (perfil "observabilidad" opcional: prometheus, grafana, langfuse) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Langfuse (self-hosted, BD propia — no compartir con POSTGRES_* de negocio):
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=langfuse_dev
LANGFUSE_POSTGRES_PASSWORD=dev-local-solo-desarrollo
LANGFUSE_NEXTAUTH_SECRET=dev-local-solo-desarrollo
LANGFUSE_SALT=dev-local-solo-desarrollo

# --- Límites de negocio ---
DOCUMENTO_TAMANO_MAX_MB=1024
DOCUMENTO_RETENCION_DIAS=90
MONEDAS_SOPORTADAS=Q,USD
