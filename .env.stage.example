# Agente Administrativo — variables de entorno para el AMBIENTE STAGE
# Copiar a .env.stage en la VM stage y completar. No versionar .env.stage con valores reales.
# Uso: docker compose --env-file .env.stage -f infra/compose.yml -f infra/compose.stage.yml up -d
# Relacionado con: docs/06-operacion/despliegue-stage-proxmox.md, infra/compose.stage.yml
#
# Sin secretos reales: todo valor sensible se marca [POR CONFIRMAR] y se entrega por
# canal seguro (no por Git ni por chat) — ver docs/06-operacion/despliegue-stage-proxmox.md §6.

# --- General ---
APP_ENV=stage
APP_NAME=agente-administrativo
APP_TIMEZONE=America/Guatemala
APP_LOCALE=es-GT
LOG_LEVEL=info

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=[POR CONFIRMAR]

# --- Orquestador (LangGraph) ---
ORQUESTADOR_MAX_CONCURRENCIA=[POR CONFIRMAR]

# --- Redis (colas / caché de sesión) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=[POR CONFIRMAR]

# --- Motor LLM (Ollama / llama.cpp) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL_PRINCIPAL=[POR CONFIRMAR]   # modelo objetivo aprobado en ADR-001 (gpt-oss-120b o Qwen3-30B-A3B)
LLM_MODEL_EMBEDDINGS=bge-m3
LLM_CONTEXT_WINDOW=[POR CONFIRMAR]

# --- Base vectorial (Qdrant) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLECCION=agente_admin_kb

# --- Base de datos relacional (PostgreSQL 16) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agente_administrativo
POSTGRES_USER=[POR CONFIRMAR]
POSTGRES_PASSWORD=[POR CONFIRMAR]

# --- Almacenamiento de objetos (MinIO) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=[POR CONFIRMAR]
MINIO_SECRET_KEY=[POR CONFIRMAR]
MINIO_BUCKET_DOCUMENTOS=documentos
MINIO_USE_SSL=false

# --- OCR ---
TESSERACT_LANG=spa
OCR_DPI_MINIMO=[POR CONFIRMAR]

# --- Ortografía (LanguageTool) ---
LANGUAGETOOL_HOST=languagetool
LANGUAGETOOL_PORT=8010
LANGUAGETOOL_LOCALE=es-GT

# --- Autenticación (AD/LDAP real) ---
LDAP_SERVER_URL=[POR CONFIRMAR]
LDAP_BASE_DN=[POR CONFIRMAR]
LDAP_BIND_DN=[POR CONFIRMAR]
LDAP_BIND_PASSWORD=[POR CONFIRMAR]

# --- Observabilidad (prometheus/grafana activos; langfuse bajo perfil "observabilidad") ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Langfuse (self-hosted, BD propia — no compartir con POSTGRES_* de negocio):
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=[POR CONFIRMAR]
LANGFUSE_POSTGRES_PASSWORD=[POR CONFIRMAR]
LANGFUSE_NEXTAUTH_URL=[POR CONFIRMAR]
LANGFUSE_NEXTAUTH_SECRET=[POR CONFIRMAR]
LANGFUSE_SALT=[POR CONFIRMAR]
LANGFUSE_ENCRYPTION_KEY=[POR CONFIRMAR]   # 64 caracteres hex (32 bytes), generar con: openssl rand -hex 32
LANGFUSE_CLICKHOUSE_USER=[POR CONFIRMAR]
LANGFUSE_CLICKHOUSE_PASSWORD=[POR CONFIRMAR]

# --- Límites de negocio ---
DOCUMENTO_TAMANO_MAX_MB=1024
DOCUMENTO_RETENCION_DIAS=90
MONEDAS_SOPORTADAS=Q,USD
